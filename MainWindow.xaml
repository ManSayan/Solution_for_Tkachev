<Window x:Class="WpfLoginApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Авторизация"
        Height="550"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Логин:" Margin="0,0,0,5" Grid.Row="0" />

        <TextBox x:Name="txtLogin"
                 Grid.Row="1"
                 Margin="0,0,0,10" />

        <TextBlock Text="Пароль:"
                   Grid.Row="2"
                   Margin="0,0,0,5" />

        <PasswordBox x:Name="txtPassword"
                     Grid.Row="3"
                     Margin="0,0,0,10" />

        <TextBlock Text="Роль:"
                   Grid.Row="4"
                   Margin="0,0,0,5" />

        <ComboBox x:Name="cbRole"
                  Grid.Row="5"
                  Margin="0,0,0,10">
            <ComboBoxItem Content="Администратор" IsSelected="True" />
            <ComboBoxItem Content="Менеджер" />
            <ComboBoxItem Content="Авторизованный клиент" />
        </ComboBox>

        <Button x:Name="btnLogin"
                Content="Войти"
                Grid.Row="6"
                Margin="0,0,0,10"
                Width="120"
                HorizontalAlignment="Left"
                Click="BtnLogin_Click" />

        <TextBlock x:Name="txtStatus"
                   Grid.Row="7"
                   Foreground="Red"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap" />

        <StackPanel x:Name="pnlCaptcha"
                    Grid.Row="8"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
            <TextBlock Text="Капча: введите сумму двух чисел"
                       FontWeight="Bold"
                       Margin="0,0,0,5" />
            <TextBlock x:Name="txtCaptcha"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,5" />
            <TextBox x:Name="txtCaptchaAnswer"
                     Width="100"
                     HorizontalAlignment="Left"
                     Margin="0,0,0,5" />
        </StackPanel>

        <TextBlock x:Name="txtLockout"
                   Grid.Row="9"
                   Foreground="DarkRed"
                   FontWeight="Bold"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
